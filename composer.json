{
  "name": "wexample/symfony-subscription-ds",
  "description": "Design-system screens for symfony-subscription: an account's plan and what is left of it, on its profile; another plan given from its page in the administration",
  "version": "2.0.4",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonySubscriptionDs\\": "src/"
    }
  },
  "require": {
    "php": ">=8.5",
    "wexample/symfony-subscription": ">=1.0.1",
    "wexample/symfony-user-ds": ">=10.0.0",
    "wexample/symfony-design-system": ">=44.0.0",
    "wexample/symfony-helpers": ">=19.1.0",
    "wexample/symfony-loader": ">=27.2.0",
    "wexample/symfony-forms": ">=16.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}